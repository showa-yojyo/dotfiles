# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples
# shellcheck disable=SC1090,SC1091

# If not running interactively, don't do anything
[[ "$-" != *i* ]] && return

# XXX: Setting XDG variables now in .bash_profile
: ${XDG_CONFIG_HOME:?Warning: XDG variables are not set.}

# History Options

# Make bash append rather than overwrite the history on disk
shopt -s histappend

# When a history substitution fails, grant a chance to edit the failed history
# substitution.
shopt -s histreedit

# Do not the results of history substitution immediately pass to the shell
# parser.
shopt -s histverify

# Address multiline history entries well.
shopt -s cmdhist lithist

# Don't put duplicate lines or lines starting with space in the history. See
# bash(1) for more options
HISTCONTROL="ignoreboth"

# Define which command lines should not be saved in the history.
# - ?, ??: one and two character commands
HISTIGNORE='?:??:cd -:hibernate*:exit:pushd*:popd*:pwd:reboot*:shutdown*:which*'

# change ~/.bash_history
HISTFILE="$XDG_STATE_HOME/bash_history"

# set only HISTSIZE but not HISTFILESIZE
HISTSIZE=1000

# %F %T, or %+4Y-%m-%d %H:%M:%S
HISTTIMEFORMAT="%F %T "

# Mail Options
MAILCHECK=0

# Shell Options
#
# See man bash for more options...

# Prevent overwriting files with redirection.
set -o noclobber

# Automatically close file descriptors assigned using the {varname}rd syntax.
shopt -s varredir_close

# Check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# When changing directory small typos can be ignored by bash
# for example, cd /vr/lgo/apaache would find /var/log/apache
shopt -s cdspell dirspell

# If set, the shell will check for running jobs before exiting.
shopt -s checkjobs

shopt -s no_empty_cmd_completion

# For better handling of glob patterns that do not match any files:
# - With nullglob, the pattern will expand to an empty string instead of
#   remaining unchanged.
# - With failglob, an error will be raised if a pattern does not match any
#   files.
shopt -s nullglob failglob

# Disable Ctrl-S and Ctrl-Q flow control.
stty -ixon

# make less more friendly for non-text input files, see lesspipe(1)
[[ -x /usr/bin/lesspipe ]] && eval "$(SHELL=/bin/sh lesspipe)"

