    if [[ -d "$dir" ]] ; then
        eval "$("${dir}/bin/brew" shellenv)"

        # <https://docs.brew.sh/Shell-Completion>
        declare f="${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
        if [[ -r "$f" ]]; then
            source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
            break

        for f in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*; do
            [[ -r "$f" ]] && source "$f"
            done
        fi
        unset f
        break
    fi
done
