# Reference: Bash Guide for Beginners
function pskill
{
    # XXX: for suspended processes, 'S' will come to $1 of awk.
    # shellcheck disable=SC2009
    pid=$(ps -a -u "$USER" -W | grep "$1" | awk '{ print $1 }')
    local -r pid
    echo -n "killing $1 (process $pid)..."
    env kill -9 "$pid"
    echo "slaughtered." >&2
}

function _g++base
{
    local -ar CPPFLAG=(-g -Werror -Wall -Wextra -ansi -pedantic -std="$1")
    local -r INFILE="${2:?Usage: ${FUNCNAME[0]} ${1} CPPFILE}"
    local -r OUTFILE=${INFILE%.cpp}
    g++ "${CPPFLAG[@]}" "$INFILE" -latomic -o "$OUTFILE"
}

function g++11
{
    _g++base c++11 "$1"
}

function g++14
{
    _g++base c++14 "$1"
}

function g++17
{
    _g++base c++17 "$1"
}

function g++20
{
    _g++base c++20 "$1"
}

# Set the title of the terminal window (or current terminal tab)
function settitle
{
     echo -ne '\033]0;'"$1"'\a'
}

# bat <https://github.com/sharkdp/bat>
function batdiff {
    git diff --name-only --relative --diff-filter=d -z | xargs -0 bat --diff
}

function bathelp {
    "$@" --help 2>&1 | bat --plain --language=help
}

function batman {
    command man "$@" 2>&1 | bat --plain --language=man
}

# EXPERIMENTAL
function help {
    case $# in
    1)
        builtin help -m "$1" | bat --plain --language=man
        ;;
    2)
        if [[ $1 == -m ]]; then
            builtin help "$@" | bat --plain --language=man
        else
            # do not use -m
            builtin help "$@"
        fi
        ;;
    *)
        builtin help "$@"
        ;;
    esac
}

# See <https://junegunn.github.io/fzf/examples/directory-navigation/>.
function z
{
    local -r selected_dir=$(
        zoxide query --list --score |
        fzf --height 40% --layout reverse --info inline \
            --nth 2.. --no-sort --query "$*" \
            --accept-nth "{2..}" \
            --preview "eza --color=always --group-directories-first --sort=extension\
              -1 -F \
              --color-scale=age --color-scale-mode=gradient \
              --smart-group --time-style=long-iso {2}"
    )
    test -d "$selected_dir" && builtin cd "$_" || return
}

